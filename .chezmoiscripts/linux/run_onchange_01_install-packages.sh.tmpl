{{ if and (eq .chezmoi.os "linux") (or (default false (index . "is_wsl")) (not (default false (index . "is_graphical")))) -}}
#!/bin/bash

# Only auto-install this CLI toolchain via mise on non-graphical Linux
# (WSL / headless servers). Graphical desktops manage their own tools.
MISE_BIN="$HOME/.local/bin/mise"
TOOLS=(bat btop eza fd fzf jq neovim rg vivid yazi zellij zoxide)
MISSING=()

if [[ ! -x "$MISE_BIN" ]]; then
    curl -fsSL https://mise.run | sh
fi

if [[ -x "$MISE_BIN" ]]; then
    # Enable automatic mise self-updates.
    "$MISE_BIN" settings set auto_update true

    # `mise ls --installed` always exits 0 and prints an empty list when the
    # tool is absent, so inspect the output instead of the exit code.
    for t in "${TOOLS[@]}"; do
        [[ "$("$MISE_BIN" ls "$t" --installed --json 2>/dev/null)" == "[]" ]] && MISSING+=("$t")
    done
    if [[ ${#MISSING[@]} -gt 0 ]]; then
        "$MISE_BIN" install "${MISSING[@]}"
        "$MISE_BIN" use -g "${MISSING[@]}"
    fi
fi
{{- end }}
