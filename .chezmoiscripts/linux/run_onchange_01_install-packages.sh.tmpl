{{ if and (eq .chezmoi.os "linux") (or (default false (index . "is_wsl")) (not (default false (index . "is_graphical")))) -}}
#!/bin/bash

# Only auto-install this CLI toolchain via mise on non-graphical Linux
# (WSL / headless servers). Graphical desktops manage their own tools.
MISE_BIN="$HOME/.local/bin/mise"
# neovim is spelled out because mise's default backend for it is vfox, whose
# install hook calls api.github.com and dies with HTTP 403 under the anonymous
# 60 req/h rate limit. The aqua backend downloads straight from the release URL.
TOOLS=(bat btop eza fd fzf jq aqua:neovim rg vivid yazi zellij zoxide)
MISSING=()

if [[ ! -x "$MISE_BIN" ]]; then
    curl -fsSL https://mise.run | sh
fi

if [[ -x "$MISE_BIN" ]]; then
    # Enable automatic mise self-updates.
    "$MISE_BIN" settings set auto_update true

    # `mise ls --installed` always exits 0 and prints an empty list when the
    # tool is absent, so inspect the output instead of the exit code. A tool
    # that is installed but not `active` is not referenced by any config file,
    # so its shim only ever fails with "No version is set for shim".
    for t in "${TOOLS[@]}"; do
        [[ "$("$MISE_BIN" ls "$t" --installed --json 2>/dev/null)" != *'"active": true'* ]] && MISSING+=("$t")
    done
    # `mise use -g` writes the config all-or-nothing, so one unresolvable tool
    # (a registry hiccup, a rate-limited backend) would leave every other tool
    # installed with no version set. Do it per tool and keep going.
    for t in "${MISSING[@]}"; do
        "$MISE_BIN" use -g "$t" || echo "mise: failed to install $t" >&2
    done
fi
{{- end }}
