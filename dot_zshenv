typeset -U path PATH

_qc-path() {
    [[ -d "$1" ]] && path=("$1" "${path[@]}")
}

_qc-source() { [[ -f $1 ]] && source $1 }

_qc-env() {
    if [[ -d "$2" ]]; then
        export $1="$2"
    fi
}

export XDG_CONFIG_HOME=~/.config
export XDG_CACHE_HOME=~/.cache
export XDG_DATA_HOME=~/.local/share
ZDOTDIR=$XDG_CONFIG_HOME/zsh
export PATH="$HOME/.local/bin:$PATH"

export EDITOR='nvim'
export VISUAL='nvim'
export LC_ALL=en_US.utf8

if [[ -z "$_QC_ENV_LOADED" ]]; then
    _qc-env BUN_INSTALL $HOME/.cache/.bun
    _qc-env PNPM_HOME $HOME/.local/share/pnpm
    _QC_ENV_LOADED=1
fi

_qc-path "$BUN_INSTALL/bin"
_qc-path "$PNPM_HOME"
_qc-source "$HOME/.cargo/env"

skip_global_compinit=1
