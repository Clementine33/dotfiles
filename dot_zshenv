typeset -U path PATH

_qc-path() {
    # When the variable is not set, “$VAR/bin” expands to literal /bin and mixes into PATH, so add a non-empty check first
    [[ -n "$1" && -d "$1" ]] && path=("$1" "${path[@]}")
}

_qc-source() { [[ -f $1 ]] && source $1 }

_qc-mise() {
    print -r -- "$XDG_DATA_HOME/mise/shims/$1"
}

# $1=variable name $2=package root $3=detection entry point (must be explicitly specified); export only if the entry point exists
_qc-env() {
    if [[ -n $3 && -e $3 ]]; then
        export "$1=$2"
    fi
}

export XDG_CONFIG_HOME=$HOME/.config
export XDG_CACHE_HOME=$HOME/.cache
export XDG_DATA_HOME=$HOME/.local/share
export XDG_STATE_HOME=$HOME/.local/state
export XDG_RUNTIME_DIR=/run/user/$UID

ZDOTDIR=$XDG_CONFIG_HOME/zsh
export PATH="$HOME/.local/bin:$PATH"

export EDITOR='nvim'
export VISUAL='nvim'

export LC_CTYPE=zh_CN.UTF-8
export LANG=en_US.UTF-8
export LC_MESSAGES=en_US.UTF-8
unset LANGUAGE

# mise's rust backend unsets RUSTUP_HOME/CARGO_HOME during activate and falls
# back to $HOME.rustup/ $HOME/.cargo, so pin them via mise's dedicated vars instead.
export MISE_RUSTUP_HOME=$XDG_DATA_HOME/rustup
export MISE_CARGO_HOME=$XDG_DATA_HOME/cargo

# Pub cache now holds only downloadable packages (global tools moved to
# `dart install`), so it's pure cache and belongs in CACHE, not DATA.
export PUB_CACHE=$XDG_CACHE_HOME/pub

# `dart install` puts globally installed CLI tools here (AOT binaries).
export DART_DATA_HOME=$XDG_DATA_HOME/dart

if [[ -z "$_QC_ENV_LOADED" ]]; then
    _qc-env GOPATH      $XDG_DATA_HOME/go      "$(_qc-mise go)"
    _qc-env CARGO_HOME  $XDG_DATA_HOME/cargo   "$(_qc-mise cargo)"
    _qc-env RUSTUP_HOME $XDG_DATA_HOME/rustup  "$(_qc-mise rustup)"
    _qc-env BUN_INSTALL $XDG_DATA_HOME/bun     "$(_qc-mise bun)"
    _qc-env PNPM_HOME   $XDG_DATA_HOME/pnpm    "$(_qc-mise pnpm)"
    _QC_ENV_LOADED=1
fi

[[ -n "$BUN_INSTALL" ]] && _qc-path "$BUN_INSTALL/bin"
[[ -n "$PNPM_HOME" ]] && _qc-path "$PNPM_HOME"
[[ -n "$CARGO_HOME" ]] && _qc-path "$CARGO_HOME/bin"
_qc-path "$DART_DATA_HOME/install/bin"

skip_global_compinit=1
